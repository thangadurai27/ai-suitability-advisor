# AI Suitability Advisor - Environment Configuration
# Copy to .env (backend) and adjust values. Never commit real keys.

# ==========================================
# DATABASE
# ==========================================
# Development default: zero-setup SQLite
DATABASE_URL="sqlite:///./ai_suitability_advisor.db"

# Production example (PostgreSQL / Supabase):
# DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres"

# ==========================================
# SECURITY
# ==========================================
# Generate a strong random value for production, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# ==========================================
# OPTIONAL INTEGRATIONS (leave unset in demo mode)
# ==========================================
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-publishable-key"
# SUPABASE_SERVICE_ROLE_KEY="your-secret-key"
# OPENROUTER_API_KEY="your-api-key"
